rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isMember(groupId) {
      return isAuth() && uid() in groupData(groupId).members;
    }

    function isAdmin(groupId) {
      return isAuth() && groupData(groupId).admin == uid();
    }

    // ── FIX 1: Backend prediction lock using raceStatus ───────────────────
    //
    // WHY THIS WORKS WITHOUT RESTRUCTURING PREDICTIONS:
    // Prediction documents are keyed by userId (not roundId), so the rule path
    // /groups/{groupId}/predictions/{userId} carries no round information.
    // Instead, the group document stores `currentOpenRound` (e.g. "round3"),
    // which the admin updates via handleEndWeekend() when transitioning rounds.
    // This function reads that field and checks the matching raceStatus doc.
    //
    // BACKWARD COMPAT: Groups created before this fix have no `currentOpenRound`
    // field. If missing, the function returns true (allow) so existing leagues
    // continue to work. Once admin runs handleEndWeekend() for the first time,
    // `currentOpenRound` is set and enforcement kicks in.
    //
    // CALL COST: groupData() is cached within one rule evaluation, so this adds
    // only 1-2 extra get/exists calls (well within the 10-call limit).

    function isRaceOpen(groupId) {
      let g = groupData(groupId);
      // No currentOpenRound set — legacy group, allow writes for compatibility
      return !('currentOpenRound' in g)
        || (
          exists(/databases/$(database)/documents/groups/$(groupId)/raceStatus/$(g.currentOpenRound))
          && get(/databases/$(database)/documents/groups/$(groupId)/raceStatus/$(g.currentOpenRound)).data.get('isPredictionOpen', false) == true
          // If overrideExpiresAt is present, enforce the 15-min window at the backend.
          // overrideExpiresAt is a Firestore Timestamp set by handleUnlockPredictions.
          && (
            !('overrideExpiresAt' in get(/databases/$(database)/documents/groups/$(groupId)/raceStatus/$(g.currentOpenRound)).data)
            || request.time < get(/databases/$(database)/documents/groups/$(groupId)/raceStatus/$(g.currentOpenRound)).data.overrideExpiresAt
          )
        );
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // FIX 2: Users can only read their own profile document.
    //
    // WHY: Previously any authenticated user could read any user doc, allowing
    // email enumeration and profile data harvesting. Single-line rule change
    // closes this.
    //
    // APP IMPACT: InvitesView and CalendarView load member nicknames via user
    // docs. After this change, reads for other members' docs will fail — they
    // are caught individually per-member (see InvitesView.loadMemberNicknames),
    // so the member list falls back to "?" for members who haven't submitted
    // predictions. Predictions and scores views are unaffected because they
    // store nickname directly on the prediction document.

    match /users/{userId} {
      allow read: if isAuth() && uid() == userId;
      allow write: if isAuth() && uid() == userId;
    }

    // ─── Groups ──────────────────────────────────────────────────────────────

    match /groups/{groupId} {
      // Only members can read the group document
      allow read: if isAuth() && uid() in resource.data.members;

      // Any authenticated user can create a group — they must be the admin
      // and seed themselves into the members array
      allow create: if isAuth()
        && request.resource.data.admin == uid()
        && request.resource.data.members.hasAll([uid()])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      // Update: admin can change anything.
      // Non-admin: only allowed to add themselves to the members array (invite join).
      //
      // NOTE: We do NOT use diff().affectedKeys() here because Firestore security
      // rules cannot evaluate diff() on writes that use FieldValue transforms
      // (arrayUnion, arrayRemove, increment, serverTimestamp). Using it causes a
      // silent false → "Missing or insufficient permissions" even when the write
      // is otherwise valid. Instead we explicitly verify that admin + name are
      // unchanged, guaranteeing no other meaningful field was modified.
      allow update: if isAuth() && (
        resource.data.admin == uid()
        || (
          // Invite join: user adds exactly themselves, nothing else changes
          request.resource.data.admin == resource.data.admin
          && request.resource.data.name == resource.data.name
          && !resource.data.members.hasAll([uid()])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll([uid()])
        )
      );

      // No client-side deletes — admin leaves by removing themselves from members
      allow delete: if false;

      // ── Predictions ──────────────────────────────────────────────────────
      // FIX 1 applied: writes also check isRaceOpen() so the prediction lock
      // is enforced at the database level, not just in the UI.
      //
      // isRaceOpen() reads group.currentOpenRound then checks
      // raceStatus/{currentOpenRound}.isPredictionOpen == true.
      // Admin sets isPredictionOpen: false when closing a round via
      // handleEndWeekend(), and sets it true when opening the next round.

      match /predictions/{userId} {
        allow read: if isMember(groupId);
        allow create, update: if isAuth() && uid() == userId && isMember(groupId) && isRaceOpen(groupId);
        allow delete: if false;
      }

      // ── Season Predictions ────────────────────────────────────────────────
      // Members can read all season predictions (shown in the season board).
      // Only the owner can write their own prediction, and must be a member.

      match /seasonPredictions/{userId} {
        allow read: if isMember(groupId);
        allow write: if isAuth() && uid() == userId && isMember(groupId);
      }

      // ── Scores ───────────────────────────────────────────────────────────
      // Scores are calculated and written by the group admin from the Results view.
      // Cloud Functions (Admin SDK) also write scores and bypass these rules.

      match /scores/{userId} {
        allow read: if isMember(groupId);
        allow write: if isAdmin(groupId);
      }

      // ── Results ──────────────────────────────────────────────────────────
      // Race results (pole, P1-P3, sprint fields, R# finisher) are entered
      // by the admin and readable by all members.

      match /results/{roundId} {
        allow read: if isMember(groupId);
        allow write: if isAdmin(groupId);
      }

      // ── Race Status ──────────────────────────────────────────────────────
      // Tracks whether a race weekend is OPEN / PAST / LOCKED.
      // Admin manages; all members can read.
      // isPredictionOpen: true  → predictions accepted
      // isPredictionOpen: false → predictions blocked (backed by isRaceOpen())

      match /raceStatus/{roundId} {
        allow read: if isMember(groupId);
        allow write: if isAdmin(groupId);
      }

      // ── Random Numbers ───────────────────────────────────────────────────
      // Only the group admin can generate the random number (create only).
      // Once created, the document is immutable — no updates or deletes allowed.
      // This prevents any member from changing the random slot after it's set,
      // even via a direct API call bypassing the UI.

      match /randomNumbers/{roundId} {
        allow read: if isMember(groupId);
        allow create: if isAdmin(groupId);
        allow update, delete: if false;
      }

      // ── Audit Log ────────────────────────────────────────────────────────
      // Only the admin can read the audit log.
      // Any member can append their own prediction-save records.
      // Updates and deletes are never allowed (immutable log).

      match /auditLog/{logId} {
        allow read: if isAdmin(groupId);
        allow create: if isMember(groupId);
        allow update, delete: if false;
      }

      // ── System Logs ──────────────────────────────────────────────────────
      // Written by handleEndWeekend and other admin-triggered operations.
      // Admin-only read/write; immutable once created.

      match /systemLogs/{logId} {
        allow read: if isAdmin(groupId);
        allow create: if isAdmin(groupId);
        allow update, delete: if false;
      }
    }

    // ─── Invites ─────────────────────────────────────────────────────────────

    match /invites/{code} {
      // Any authenticated user can read an invite (to display the accept modal)
      allow read: if isAuth();

      // Only the admin of the target league can create an invite for it
      allow create: if isAuth()
        && isAdmin(request.resource.data.leagueId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.usedCount == 0;

      // Any authenticated user can increment usedCount by exactly 1 (accepting invite).
      // Same reason as above: avoid diff().affectedKeys() with transforms.
      // Explicitly verify the immutable fields are unchanged instead.
      allow update: if isAuth()
        && request.resource.data.leagueId == resource.data.leagueId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.usedCount == resource.data.usedCount + 1;

      allow delete: if false;
    }

  }
}
